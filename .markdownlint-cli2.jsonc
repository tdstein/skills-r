{
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    "node_modules",
    "vendor/**"
  ],
  "fix": false,
  "config": {
    "MD010": false,
    "MD013": false,
    "MD024": false,
    "MD033": false,
    "MD036": false,
    "MD040": false,
    "MD041": false
  },
  "customRules": [],
  "outputFormatters": [
    [
      "markdownlint-cli2-formatter-default"
    ]
  ]
}
